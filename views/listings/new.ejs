<% layout("layouts/boilerplate") %>
<div class="row justify-content-center">
  <div class="col-lg-7">
    <h3 class="mb-3">List a new place</h3>
    <form action="/listings" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>
      <div class="mb-3">
        <label class="form-label" for="title">Title</label>
        <input class="form-control" id="title" name="listing[title]" maxlength="100" required>
        <div class="invalid-feedback">Please add a title.</div>
      </div>
      <div class="mb-3">
        <label class="form-label" for="description">Description</label>
        <textarea class="form-control" id="description" name="listing[description]" rows="4" required></textarea>
        <div class="invalid-feedback">Please describe your place.</div>
      </div>
      <div class="mb-3">
        <label class="form-label" for="image">Photo</label>
        <input class="form-control" type="file" id="image" name="listing[image]" accept="image/png,image/jpeg,image/webp">
        <div class="form-text">JPG, PNG or WEBP, up to 5 MB.</div>
      </div>
      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label" for="price">Price / night (&#8377;)</label>
          <input class="form-control" type="number" min="0" id="price" name="listing[price]" required>
          <div class="invalid-feedback">Enter a price.</div>
        </div>
        <div class="col-md-8 mb-3">
          <label class="form-label" for="country">Country</label>
          <input class="form-control" id="country" name="listing[country]" required>
          <div class="invalid-feedback">Enter a country.</div>
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label" for="location">Location</label>
        <input class="form-control" id="location" name="listing[location]" required>
        <div class="invalid-feedback">Enter a location.</div>
      </div>
      <button class="btn btn-brand">Publish listing</button>
    </form>
  </div>
</div>
